<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.SysWechatUserMapper">
    
    <resultMap type="SysWechatUser" id="SysWechatUserResult">
        <result property="id"          column="id"           />
        <result property="userId"      column="user_id"      />
        <result property="openid"      column="openid"       />
        <result property="unionid"     column="unionid"      />
        <result property="nickname"    column="nickname"     />
        <result property="avatar"      column="avatar"       />
        <result property="gender"      column="gender"       />
        <result property="province"    column="province"     />
        <result property="city"        column="city"         />
        <result property="country"     column="country"      />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectSysWechatUserVo">
        select id, user_id, openid, unionid, nickname, avatar, gender, province, city, country, 
               create_by, create_time, update_by, update_time, remark
        from sys_wechat_user
    </sql>

    <select id="selectSysWechatUserById" parameterType="Long" resultMap="SysWechatUserResult">
        <include refid="selectSysWechatUserVo"/>
        where id = #{id}
    </select>

    <select id="selectSysWechatUserByOpenid" parameterType="String" resultMap="SysWechatUserResult">
        <include refid="selectSysWechatUserVo"/>
        where openid = #{openid}
    </select>

    <select id="selectByOpenid" parameterType="String" resultMap="SysWechatUserResult">
        <include refid="selectSysWechatUserVo"/>
        where openid = #{openid}
    </select>

    <select id="selectSysWechatUserByUserId" parameterType="Long" resultMap="SysWechatUserResult">
        <include refid="selectSysWechatUserVo"/>
        where user_id = #{userId}
    </select>

    <select id="selectByUserId" parameterType="Long" resultMap="SysWechatUserResult">
        <include refid="selectSysWechatUserVo"/>
        where user_id = #{userId}
    </select>

    <select id="selectSysWechatUserByInvitationCode" parameterType="String" resultMap="SysWechatUserResult">
        select w.id, w.user_id, w.openid, w.unionid, w.nickname, w.avatar, w.gender, w.province, w.city, w.country, 
               w.create_by, w.create_time, w.update_by, w.update_time, w.remark
        from sys_wechat_user w
        inner join sys_tbk_agent_apply a on w.user_id = a.user_id
        where a.invitation_code = #{invitationCode}
    </select>

    <select id="selectSysWechatUserList" parameterType="SysWechatUser" resultMap="SysWechatUserResult">
        <include refid="selectSysWechatUserVo"/>
        <where>
            <if test="userId != null">and user_id = #{userId}</if>
            <if test="openid != null and openid != ''">and openid = #{openid}</if>
            <if test="unionid != null and unionid != ''">and unionid = #{unionid}</if>
            <if test="nickname != null and nickname != ''">and nickname like concat('%', #{nickname}, '%')</if>
        </where>
    </select>

    <insert id="insertSysWechatUser" parameterType="SysWechatUser" useGeneratedKeys="true" keyProperty="id">
        insert into sys_wechat_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="openid != null and openid != ''">openid,</if>
            <if test="unionid != null">unionid,</if>
            <if test="nickname != null">nickname,</if>
            <if test="avatar != null">avatar,</if>
            <if test="gender != null">gender,</if>
            <if test="province != null">province,</if>
            <if test="city != null">city,</if>
            <if test="country != null">country,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="openid != null and openid != ''">#{openid},</if>
            <if test="unionid != null">#{unionid},</if>
            <if test="nickname != null">#{nickname},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="gender != null">#{gender},</if>
            <if test="province != null">#{province},</if>
            <if test="city != null">#{city},</if>
            <if test="country != null">#{country},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>

    <update id="updateSysWechatUser" parameterType="SysWechatUser">
        update sys_wechat_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="unionid != null">unionid = #{unionid},</if>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="province != null">province = #{province},</if>
            <if test="city != null">city = #{city},</if>
            <if test="country != null">country = #{country},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteSysWechatUserById" parameterType="Long">
        delete from sys_wechat_user where id = #{id}
    </delete>

    <delete id="deleteSysWechatUserByIds" parameterType="Long">
        delete from sys_wechat_user where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
