/* pages/about/index.wxss - 关于我们样式 */
.container {
  min-height: 100vh;
  background: #f5f7fa;
}

/* 顶部区域 */
.header-section {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}

.header-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  opacity: 0.95;
}

.header-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 40rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.app-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.slogan {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  letter-spacing: 4rpx;
}

/* 内容区域 */
.content-section {
  padding: 32rpx 24rpx 48rpx;
  margin-top: -40rpx;
  position: relative;
  z-index: 2;
}

/* 欢迎卡片 */
.welcome-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.25);
}

.card-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.title-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.welcome-text {
  font-size: 28rpx;
  line-height: 44rpx;
  color: rgba(255, 255, 255, 0.95);
  text-align: justify;
}

/* 通用卡片样式 */
.section-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

/* 区块标题 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-line {
  width: 6rpx;
  height: 32rpx;
  background: linear-gradient(to bottom, #667eea, #764ba2);
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-intro {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #666;
  margin-bottom: 28rpx;
  text-align: justify;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  border-left: 4rpx solid #667eea;
}

/* 功能特性列表 */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: linear-gradient(135deg, #f8f9ff 0%, #fafaff 100%);
  border-radius: 16rpx;
  border: 2rpx solid #e8ebf5;
  transition: all 0.3s;
}

.feature-number {
  flex-shrink: 0;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 50%;
  margin-right: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.feature-content {
  flex: 1;
}

.feature-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.feature-desc {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #666;
  text-align: justify;
}

/* 优势列表 */
.advantage-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.advantage-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 2rpx solid #f0f0f0;
  transition: all 0.3s;
}

.advantage-icon {
  flex-shrink: 0;
  font-size: 48rpx;
  margin-right: 20rpx;
  line-height: 1;
}

.advantage-content {
  flex: 1;
}

.advantage-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.advantage-desc {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #666;
  text-align: justify;
}

/* 理念内容 */
.concept-content {
  font-size: 26rpx;
  line-height: 44rpx;
  color: #666;
  text-align: justify;
  padding: 24rpx;
  background: linear-gradient(135deg, #fff5f5 0%, #fff8f8 100%);
  border-radius: 12rpx;
  border-left: 4rpx solid #764ba2;
}

/* 承诺列表 */
.promise-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.promise-item {
  padding: 24rpx;
  background: linear-gradient(135deg, #f0f4ff 0%, #f5f7ff 100%);
  border-radius: 16rpx;
  border-left: 6rpx solid #667eea;
}

.promise-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}

.promise-text {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #666;
  text-align: justify;
}

/* 展望未来卡片 */
.future-card {
  background: linear-gradient(135deg, #fff9e6 0%, #fffbf0 100%);
  border: 2rpx solid #ffe8a3;
  text-align: center;
}

.future-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.future-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.future-text {
  font-size: 26rpx;
  line-height: 44rpx;
  color: #666;
  text-align: justify;
}

/* 联系方式卡片 */
.contact-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.contact-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.contact-item:last-child {
  border-bottom: none;
}

.contact-label {
  font-size: 28rpx;
  color: #999;
  min-width: 160rpx;
}

.contact-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* 底部版权 */
.copyright {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 32rpx 0;
}

.copyright-text {
  font-size: 24rpx;
  color: #999;
}
