/* pages/share/index.wxss - 分享推广样式 */
.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 32rpx 24rpx;
}

/* 未登录/非代理提示 */
.login-tip-card,
.not-agent-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  margin-top: 80rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.tip-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.tip-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.tip-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 48rpx;
  text-align: center;
}

.login-btn,
.apply-btn {
  width: 400rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

/* 代理内容区 */
.agent-content {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 成功提示 */
.success-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  border-left: 8rpx solid #4caf50;
}

.success-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.success-info {
  display: flex;
  flex-direction: column;
}

.success-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2e7d32;
  margin-bottom: 8rpx;
}

.success-desc {
  font-size: 26rpx;
  color: #666;
}

/* 邀请码卡片 */
.invitation-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.35);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.header-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.header-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.invitation-code-wrapper {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
}

.invitation-code {
  flex: 1;
  font-size: 52rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 8rpx;
  font-family: monospace;
}

.copy-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #fff;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  min-width: 0;
  line-height: 1.4;
}

.copy-icon {
  font-size: 28rpx;
}

.card-tips {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tips-icon {
  font-size: 28rpx;
}

.card-tips text:last-child {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 代理信息卡片 */
.info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.info-list {
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  min-width: 160rpx;
}

.info-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  flex: 1;
}

/* 平台标签样式 */
.info-item-platforms {
  align-items: flex-start;
}

.platforms-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: center;
}

.platform-tag {
  display: inline-block;
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.25);
}

/* 推广指南卡片 */
.guide-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.guide-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.guide-icon {
  font-size: 32rpx;
}

.guide-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.guide-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.guide-number {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

/* 分享按钮 */
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #4caf50 0%, #2e7d32 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.35);
}

.share-icon {
  font-size: 36rpx;
}

/* 快捷入口 */
.quick-links {
  display: flex;
  gap: 24rpx;
}

.link-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  gap: 12rpx;
}

.link-icon {
  font-size: 48rpx;
}

.link-text {
  font-size: 26rpx;
  color: #555;
  font-weight: 500;
}
