/* pages/auth/login/login.wxss */
.login-container {
  width: 100%;
  height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  animation: float 6s ease-in-out infinite;
}

.circle-1 {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -100rpx;
  animation-delay: 0s;
}

.circle-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: 100rpx;
  left: -50rpx;
  animation-delay: 2s;
}

.circle-3 {
  width: 150rpx;
  height: 150rpx;
  top: 50%;
  right: 10%;
  animation-delay: 4s;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.7;
  }
  50% {
    transform: translateY(-30rpx) scale(1.1);
    opacity: 1;
  }
}

.login-content {
  width: 90%;
  max-width: 600rpx;
  padding: 60rpx 40rpx 50rpx;
  background: #ffffff;
  border-radius: 30rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  position: relative;
  z-index: 1;
  animation: slideUp 0.5s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* Logo区域 */
.logo-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo-wrapper {
  position: relative;
  display: inline-block;
  margin-bottom: 30rpx;
}

.logo-bg {
  width: 180rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  position: relative;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 0 0 0 rgba(102, 126, 234, 0.4);
  }
  50% {
    transform: scale(1.05);
    box-shadow: 0 0 0 20rpx rgba(102, 126, 234, 0);
  }
}

.logo-icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 80rpx;
  line-height: 1;
}

.app-name {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 15rpx;
  letter-spacing: 2rpx;
}

.app-desc {
  display: block;
  font-size: 26rpx;
  color: #999999;
  letter-spacing: 1rpx;
}

/* 功能亮点 */
.features {
  display: flex;
  justify-content: space-around;
  margin-bottom: 60rpx;
  padding: 0 20rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.feature-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #f5f7fa 0%, #e8ebf0 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.feature-text {
  font-size: 24rpx;
  color: #666666;
}

/* 登录按钮区域 */
.login-section {
  margin-bottom: 40rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border: none;
  border-radius: 48rpx;
  font-size: 32rpx;
  color: #ffffff;
  margin-bottom: 25rpx;
  padding: 0;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn::after {
  border: none;
}

.login-btn[disabled] {
  opacity: 0.6;
}

.btn-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15rpx;
}

.wechat-icon {
  font-size: 36rpx;
  line-height: 1;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 500;
}

.cancel-btn {
  width: 100%;
  height: 96rpx;
  background: transparent;
  border: 2rpx solid #e8e8e8;
  border-radius: 48rpx;
  font-size: 30rpx;
  color: #666666;
  padding: 0;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cancel-btn::after {
  border: none;
}

/* 服务协议 */
.agreement-section {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999999;
  line-height: 40rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.agreement-checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #667eea;
}

.checkbox-icon {
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
  line-height: 1;
}

.agreement-text {
  color: #999999;
}

.agreement-link {
  color: #667eea;
  font-weight: 500;
}
