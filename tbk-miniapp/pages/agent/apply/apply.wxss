/* pages/agent/apply/apply.wxss */

.apply-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #ffffff 100%);
  padding: 20rpx 20rpx 40rpx;
}

/* ========== 表单区域 ========== */
.form-section {
  animation: fadeIn 0.5s ease-in;
}

/* 表单头部 */
.form-header {
  text-align: center;
  padding: 40rpx 20rpx;
  margin-bottom: 30rpx;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  animation: bounce 1s ease-in-out infinite;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 15rpx;
}

.header-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
  line-height: 1.6;
}

/* 表单主体 */
.form-body {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 分区标题 */
.section-title {
  display: flex;
  align-items: center;
  margin: 40rpx 0 30rpx;
}

.section-title:first-child {
  margin-top: 0;
}

.title-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #e0e0e0, transparent);
}

.title-text {
  padding: 0 20rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
}

/* 表单项 */
.form-item {
  margin-bottom: 35rpx;
  position: relative;
}

.item-label {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.label-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.label-required {
  color: #ff4d4f;
  margin-left: 5rpx;
  font-size: 28rpx;
}

.label-optional {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.item-input,
.item-textarea,
.item-picker {
  width: 100%;
  background-color: #f7f8fa;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  transition: all 0.3s ease;
}

.item-input,
.item-picker {
  height: 88rpx;
}

/* Picker样式 */
.item-picker {
  display: flex;
  align-items: center;
}

.picker-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100%;
}

.picker-arrow {
  font-size: 40rpx;
  color: #999;
  font-weight: 300;
  margin-left: 10rpx;
}

/* Checkbox 多选列表样式 */
.platform-checkbox-list {
  background-color: #f7f8fa;
  border-radius: 12rpx;
  padding: 10rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin: 5rpx 0;
  background-color: #fff;
  border-radius: 8rpx;
  transition: all 0.3s ease;
}

.checkbox-item:active {
  background-color: #f0f0f0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #d9d9d9;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.checkbox.checked {
  background-color: #1890ff;
  border-color: #1890ff;
}

.checkbox-icon {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  line-height: 1;
}

.checkbox-label {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.item-input:focus,
.item-textarea:focus {
  background-color: #fff;
  border-color: #1890ff;
  box-shadow: 0 0 0 4rpx rgba(24, 144, 255, 0.1);
}

.item-textarea {
  min-height: 160rpx;
  padding: 20rpx;
  line-height: 1.6;
}

.item-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

.textarea-counter {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 10rpx;
}

/* AppSecret切换显示 */
.toggle-secret {
  position: absolute;
  right: 20rpx;
  top: 75rpx;
  padding: 10rpx 20rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 24rpx;
  border-radius: 20rpx;
  z-index: 10;
}

/* 信息提示卡片 */
.info-tip {
  background: linear-gradient(135deg, #e6f7ff 0%, #f0f9ff 100%);
  border-left: 4rpx solid #1890ff;
  border-radius: 12rpx;
  padding: 25rpx;
  margin-bottom: 30rpx;
  display: flex;
  gap: 15rpx;
}

.tip-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tip-content {
  flex: 1;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #0050b3;
  margin-bottom: 12rpx;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #0050b3;
  line-height: 1.8;
  margin-bottom: 6rpx;
}

.tip-text:last-child {
  margin-bottom: 0;
}

/* 表单底部 */
.form-footer {
  padding: 60rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.submit-btn {
  width: 60%;
  min-width: 360rpx;
  max-width: 500rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 48rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.submit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

.submit-btn[disabled] {
  background: linear-gradient(135deg, #d9d9d9 0%, #bfbfbf 100%);
  box-shadow: none;
}

.footer-tip {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}

/* ========== 状态区域 ========== */
.status-section {
  animation: fadeIn 0.5s ease-in;
}

.status-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 状态头部 */
.status-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.status-icon {
  font-size: 80rpx;
  flex-shrink: 0;
}

.status-info {
  flex: 1;
}

.status-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.status-desc {
  display: block;
  font-size: 26rpx;
  color: #999;
}

/* 状态颜色 */
.status-pending .status-title {
  color: #faad14;
}

.status-approved .status-title {
  color: #52c41a;
}

.status-rejected .status-title {
  color: #ff4d4f;
}

/* 信息卡片 */
.info-card,
.agent-info-card {
  background-color: #fafafa;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 15rpx;
  border-bottom: 2rpx solid #e8e8e8;
}

.info-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.info-item:last-child {
  margin-bottom: 0;
}

.info-label {
  color: #666;
  min-width: 150rpx;
  flex-shrink: 0;
}

.info-value {
  color: #333;
  flex: 1;
  word-break: break-all;
}

/* 邀请码卡片 */
.invitation-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20rpx;
  padding: 35rpx;
  margin-bottom: 25rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 25rpx;
}

.card-icon {
  font-size: 32rpx;
}

.invitation-card .card-title {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
  margin: 0;
  padding: 0;
  border: none;
}

.invitation-code-wrapper {
  background-color: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  padding: 25rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.invitation-code {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  letter-spacing: 4rpx;
  font-family: 'Courier New', monospace;
}

.copy-btn {
  background-color: rgba(255, 255, 255, 0.3);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 25rpx;
  padding: 15rpx 30rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.copy-btn:active {
  background-color: rgba(255, 255, 255, 0.4);
}

.copy-icon {
  font-size: 28rpx;
}

.card-tips {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.tips-icon {
  font-size: 28rpx;
}

/* 提示卡片 */
.tips-card {
  background-color: #e6f7ff;
  border-left: 4rpx solid #1890ff;
  border-radius: 12rpx;
  padding: 25rpx;
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.tips-card .tips-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.tips-text {
  font-size: 26rpx;
  color: #0050b3;
  line-height: 1.6;
}

/* 拒绝原因卡片 */
.reject-card {
  background-color: #fff2f0;
  border-left: 4rpx solid #ff4d4f;
  border-radius: 12rpx;
  padding: 25rpx;
  margin-bottom: 20rpx;
}

.reject-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: #ff4d4f;
  margin-bottom: 12rpx;
}

.reject-icon {
  font-size: 28rpx;
}

.reject-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  display: block;
}

/* 分享按钮 */
.share-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(82, 196, 26, 0.3);
}

.share-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(82, 196, 26, 0.3);
}

.share-icon {
  font-size: 32rpx;
}

/* 重新申请按钮容器（实现上下居中） */
.reapply-btn-wrapper {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0;
  margin-top: 20rpx;
}

/* 重新申请按钮 */
.reapply-btn {
  width: 60%;
  min-width: 360rpx;
  max-width: 500rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #1890ff 0%, #096dd9 100%);
  border-radius: 44rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.reapply-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 16rpx rgba(24, 144, 255, 0.3);
}

/* 空驳回原因样式 */
.reject-empty {
  color: #999;
  font-style: italic;
}

/* ========== 动画效果 ========== */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes bounce {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}
